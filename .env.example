# Database
DB_USER=postgres
DB_PASSWORD=your_password #enter your value
DB_NAME=easyrail_db
DB_HOST=127.0.0.1
DB_PORT=6543

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@easyrail.com
PGADMIN_DEFAULT_PASSWORD=your_password #enter your value
PGADMIN_HOST=127.0.0.1
PGADMIN_PORT=5050

# Backend
PORT=8080
BACKEND_PORT=8080
NODE_ENV=development # development | production | test
LOG_LEVEL=info # fatal | error | warn | info | debug | trace | silent
JWT_SECRET=super_secret_jwt_key_easyrail


