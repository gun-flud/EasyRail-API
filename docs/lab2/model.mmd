flowchart TD
    %% ==========================================
    %% АКТОРИ СИСТЕМИ
    %% ==========================================
    subgraph HumanActors ["Людські актори"]
        Guest["Гість (Guest)"]
        User["Зареєстрований користувач"]
        Admin["Адміністратор / Диспетчер (Admin)"]
        Conductor["Провідник"]
        Guest -.->|Generalization| User
    end

    subgraph ExternalActors ["Зовнішні та системні актори"]
        PaymentProcess["Зовнішній платіжний процес (LiqPay/Mono)"]
        HoldWorker["Воркер очищення холдів (SKIP LOCKED)"]
        TripWorker["Воркер створення рейсів (за 14 днів)"]
        NotifWorker["Воркер сповіщень (за 2 години)"]
    end

    %% ==========================================
    %% 1. МОДУЛЬ КУПІВЛІ КВИТКА (TICKET PURCHASE)
    %% ==========================================
    subgraph Subsystem1 ["1. Модуль купівлі квитка (Ticket Purchase Flow)"]
        direction TB
        UC_InputSearch["Введення дати, станції відправлення та прибуття"]
        UC_GetTrainList["Отримання списку поїздів на обрану дату"]
        UC_SelectTrain["Вибір потяга"]
        UC_SeatWindow["Вікно вибору вагона, кількості місць та розташування"]
        
        UC_Hold10Min["Бронювання місця: фіксація ticket_segment у статусі HELD на 10 хв"]
        UC_CheckIntervals["Перевірка перетину інтервалів місця (max < min)"]
        UC_CheckSingleHold["Перевірка ліміту 1 активного холда на користувача"]

        %% Гілка -1: Таймаут
        UC_TimeoutExpired["-1> Користувач не встигає за 10 хв ввести дані та оплатити"]
        UC_HoldRemoved["Холд зникає: статус EXPIRED, сегмент місця звільняється воркером"]

        %% Гілка -2: Успішна покупка
        UC_FillPassenger["-2> Заповнення персональних даних пасажира (себе / попутника)"]
        UC_SaveCompanion["Автозбереження нового попутника в довідник passengers"]
        UC_MakePurchase["Ініціація покупки: перехід на зовнішній платіжний процес"]
        UC_PaymentApproved["Схвалення покупки зовнішнім платіжним процесом"]
        UC_FinalizeTicket["Квиток фіксується за користувачем (PAID) та вносяться всі дані в сегмент (Snapshot)"]
        UC_GenPDF["Генерація та видача електронного PDF-квитка"]

        %% Послідовний ланцюг дій користувача
        UC_InputSearch --> UC_GetTrainList
        UC_GetTrainList --> UC_SelectTrain
        UC_SelectTrain --> UC_SeatWindow
        UC_SeatWindow --> UC_Hold10Min

        %% Включення обов'язкових перевірок при бронюванні
        UC_Hold10Min -.->|"<<include>>"| UC_CheckIntervals
        UC_Hold10Min -.->|"<<include>>"| UC_CheckSingleHold

        %% Розгалуження холда
        UC_Hold10Min --> UC_TimeoutExpired
        UC_TimeoutExpired --> UC_HoldRemoved

        UC_Hold10Min --> UC_FillPassenger
        UC_SaveCompanion -.->|"<<extend>>"| UC_FillPassenger
        UC_FillPassenger --> UC_MakePurchase
        UC_MakePurchase --> UC_PaymentApproved
        UC_PaymentApproved --> UC_FinalizeTicket
        UC_FinalizeTicket -.->|"<<include>>"| UC_GenPDF
    end

    %% ==========================================
    %% 2. МОДУЛЬ ІСТОРІЇ ПОЇЗДОК ТА КАБІНЕТУ
    %% ==========================================
    subgraph Subsystem2 ["2. Модуль історії поїздок та кабінету (Trip History & Profile)"]
        direction TB
        UC_OpenHistoryMenu["Вхід у меню кабінету 'Історія поїздок'"]
        UC_ViewPaid["Перегляд придбаних квитків (PAID) та активних холдів (HELD)"]
        UC_ViewCancelled["Перегляд відхилених / скасованих (CANCELLED) та прострочених (EXPIRED) поїздок"]
        UC_RefundTicket["Оформлення повернення квитка"]
        UC_CheckRefundDeadline["Перевірка дедлайну: (departure_time - NOW()) >= 2 години"]

        UC_OpenHistoryMenu --> UC_ViewPaid
        UC_OpenHistoryMenu --> UC_ViewCancelled
        UC_ViewPaid --> UC_RefundTicket
        UC_RefundTicket -.->|"<<include>>"| UC_CheckRefundDeadline
    end

    %% ==========================================
    %% 3. МОДУЛЬ СТВОРЕННЯ ПОЇЗДОК
    %% ==========================================
    subgraph Subsystem3 ["3. Модуль створення поїздок (Trip Generation Worker & Admin)"]
        direction TB
        UC_AdminInputTrain["Admin вводить назву та основні дані нового потяга (маршрут, вагони, розклад)"]
        UC_WorkerGenerateTrips["Воркер самостійно створює trips завчасно за 2 тижні (14 днів) до дати"]
        
        UC_AdminInputTrain --> UC_WorkerGenerateTrips
        UC_WorkerGenerateTrips -.->|Відкриває для пошуку| UC_GetTrainList
    end

    %% ==========================================
    %% 4. МОДУЛЬ ВІДПРАВКИ ПОВІДОМЛЕНЬ
    %% ==========================================
    subgraph Subsystem4 ["4. Модуль відправки повідомлень (Passenger Notifications)"]
        direction TB
        UC_Scan2Hours["Система позначає квитки, в яких через 2 години прибуває потяг на їхню зупинку"]
        UC_Send2HoursNotif["Відправка повідомлення: 'На вашу зупинку прийде потяг через 2 години!'"]
        UC_SendDelayNotif["Сповіщення про затримку або оперативні зміни рейсу"]

        UC_Scan2Hours --> UC_Send2HoursNotif
    end

    %% ==========================================
    %% ЗВ'ЯЗКИ АКСОРІВ ІЗ ПРОЦЕСАМИ
    %% ==========================================
    Guest --> UC_InputSearch
    User --> UC_InputSearch
    User --> UC_OpenHistoryMenu

    HoldWorker --> UC_HoldRemoved
    UC_MakePurchase <--> PaymentProcess
    PaymentProcess --> UC_PaymentApproved
    UC_RefundTicket --> PaymentProcess

    Admin --> UC_AdminInputTrain
    TripWorker --> UC_WorkerGenerateTrips

    NotifWorker --> UC_Scan2Hours
    NotifWorker --> UC_SendDelayNotif
    Admin --> UC_SendDelayNotif

    Conductor --> UC_ViewPaid
