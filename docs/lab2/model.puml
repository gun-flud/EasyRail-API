@startuml EasyRail_UseCase_Model
' ==============================================================================
' EasyRail Core API — Діаграма прецедентів та архітектурних процесів (PlantUML)
' ==============================================================================

left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam roundcorner 8
skinparam actorStyle awesome

skinparam package {
  BackgroundColor #F8F9FA
  BorderColor #6C757D
  FontColor #212529
  FontStyle bold
}

skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #0D6EFD
  ArrowColor #495057
}

skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #198754
}

' ==========================================
' ЛЮДСЬКІ АКТОРИ
' ==========================================
actor "Гість (Guest)" as Guest #LightYellow
actor "Зареєстрований користувач" as User #LightCyan
actor "Адміністратор розкладу (Admin)" as Admin #MistyRose
actor "Провідник" as Conductor #Wheat

' Узагальнення користувача від гостя
User -up-|> Guest : <<generalization>>

' ==========================================
' ЗОВНІШНІ ТА СИСТЕМНІ АКТОРИ
' ==========================================
actor "Зовнішній платіжний процес\n(LiqPay / Monobank)" as PaymentProcess <<External Process>> #Honeydew
actor "Воркер очищення холдів\n(SKIP LOCKED)" as HoldWorker <<System Worker>> #Lavender
actor "Воркер рейсів\n(за 14 днів наперед)" as TripWorker <<System Cron>> #Lavender
actor "Воркер сповіщень\n(за 2 години до поїзда)" as NotifWorker <<System Daemon>> #Lavender

' ==============================================================================
' 1. МОДУЛЬ КУПІВЛІ КВИТКА (TICKET PURCHASE FLOW)
' ==============================================================================
package "1. Модуль купівлі квитка (Ticket Purchase Flow)" {
  usecase "UC-01: Введення дати, станції відправлення та прибуття" as UC01
  usecase "UC-02: Отримання списку поїздів на обрану дату" as UC02
  usecase "UC-03: Вибір потяга" as UC03
  usecase "UC-04: Вікно вибору вагона, кількості місць та розташування" as UC04
  
  usecase "UC-05: Бронювання місця\n(Холд ticket_segment на 10 хв)" as UC05
  usecase "UC-06: Перевірка перетину інтервалів\n(max < min)" as UC06
  usecase "UC-07: Перевірка ліміту 1 активного холда\nна користувача" as UC07

  ' Гілка -1: Таймаут холда
  usecase "UC-08: -1> Не встиг ввести дані за 10 хв" as UC08
  usecase "UC-09: Зняття холда:\nстатус -> EXPIRED та звільнення місця" as UC09

  ' Гілка -2: Успішна покупка
  usecase "UC-10: -2> Заповнення персональних даних пасажира" as UC10
  usecase "UC-11: Автозбереження нового попутника\nв довідник passengers" as UC11
  usecase "UC-12: Ініціація покупки:\nперехід на зовнішній платіжний процес" as UC12
  usecase "UC-13: Схвалення покупки платіжним процесом" as UC13
  usecase "UC-14: Квиток фіксується за користувачем (PAID)\nта вноситься Snapshot у сегмент" as UC14
  usecase "UC-15: Генерація та видача електронного PDF-квитка" as UC15
}

' Ланцюг покупки квитка
UC01 --> UC02
UC02 --> UC03
UC03 --> UC04
UC04 --> UC05

UC05 ..> UC06 : <<include>>
UC05 ..> UC07 : <<include>>

UC05 --> UC08
UC08 --> UC09

UC05 --> UC10
UC11 ..> UC10 : <<extend>>
UC10 --> UC12
UC12 --> UC13
UC13 --> UC14
UC14 ..> UC15 : <<include>>

' ==============================================================================
' 2. КАБІНЕТ КОРИСТУВАЧА (СУТО ДЛЯ USER)
' ==============================================================================
package "2. Кабінет користувача (User Cabinet & My Trips)" {
  usecase "UC-16: Перегляд активних квитків (PAID)\nта холд-сесій (HELD)" as UC16
  usecase "UC-17: Відмова від заброньованого холда\n(зняття статусу -> EXPIRED та звільнення місця)" as UC17
  usecase "UC-18: Оформлення повернення квитка (PAID)" as UC18
  usecase "UC-19: Валідація правила дедлайну:\n(departure_time - NOW()) >= 2 години" as UC19
  usecase "UC-20: Перегляд архіву поїздок\n(завершені, CANCELLED, EXPIRED)" as UC20
}

UC16 --> UC17
UC16 --> UC18
UC18 ..> UC19 : <<include>>

' ==============================================================================
' 3. КАБІНЕТ АДМІНІСТРАТОРА (СУТО ДЛЯ ADMIN)
' ==============================================================================
package "3. Кабінет адміністратора (Admin Workspace & Management)" {
  usecase "UC-21: Введення даних нового потяга\n(маршрут, зупинки, типи вагонів)" as UC21
  usecase "UC-22: Автоматична генерація рейсів\nза 14 днів наперед (trips)" as UC22
  usecase "UC-23: Перегляд статистики та аналітики\nнавантаження потягів і заповненості" as UC23
  usecase "UC-24: Внесення даних про затримку рейсу\n(trips.delay_minutes)" as UC24
}

UC21 --> UC22
UC22 ..> UC02 : відкриває нові рейси

' ==============================================================================
' 4. МОДУЛЬ СПОВІЩЕНЬ ПАСАЖИРІВ
' ==============================================================================
package "4. Модуль відправки повідомлень (Passenger Notifications)" {
  usecase "UC-25: Позначення квитків та відправка сповіщення\n'На вашу зупинку прийде потяг через 2 години!'" as UC25
  usecase "UC-26: Сповіщення про затримку\nабо оперативні зміни рейсу" as UC26
}

' ==============================================================================
' 5. СЛУЖБОВИЙ КОНТРОЛЬ ПОСАДКИ
' ==============================================================================
package "5. Службовий контроль посадки (Conductor Service)" {
  usecase "UC-27: Валідація електронного квитка\nпри посадці пасажира (перевірка QR)" as UC27
}

' ==========================================
' ЗВ'ЯЗКИ АКСОРІВ ІЗ СИСТЕМОЮ
' ==========================================
' Користувач і гість
Guest --> UC01
User --> UC01
User --> UC16
User --> UC20

' Зовнішній платіжний процес
UC12 <--> PaymentProcess
PaymentProcess --> UC13
UC18 --> PaymentProcess : реверс коштів

' Воркери
HoldWorker --> UC09
HoldWorker --> UC17
TripWorker --> UC22
NotifWorker --> UC25
NotifWorker --> UC26

' Адміністратор
Admin --> UC21
Admin --> UC23
Admin --> UC24
UC24 --> UC26 : тригер оновлення

' Провідник
Conductor --> UC27

@enduml
